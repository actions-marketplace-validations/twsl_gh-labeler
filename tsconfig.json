{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./tsconfig.base.json",
	"baseUrl": ".",
	"paths": {
		"@/*": [
			"src/*"
		]
	},
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "./dist"
	},
	"exclude": [
		"tests",
		"coverage",
		"dist",
		"node_modules"
	],
	"include": [
		"src"
	]
}