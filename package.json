{
	"name": "gh-labeler",
	"description": "GitHub Actions TypeScript template",
	"version": "0.0.0",
	"author": {
		"name": "twsl",
		"email": "45483159+twsl@users.noreply.github.com"
	},
	"type": "module",
	"private": true,
	"homepage": "https://github.com/twsl/gh-labeler",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/twsl/gh-labeler.git"
	},
	"bugs": {
		"url": "https://github.com/twsl/gh-labeler/issues"
	},
	"keywords": [
		"actions",
		"github",
		"typescript",
		"issues",
		"labels",
		"discussions",
		"close",
		"reopen",
		"lock",
		"unlock",
		"assign",
		"unassign",
		"comment",
		"delete"
	],
	"exports": {
		".": "./dist/index.js"
	},
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"bundle": "pnpm run format && pnpm run package",
		"coverage": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 pnpx jest --coverage",
		"format": "pnpx @biomejs/biome format --write .devcontainer .vscode biome.json data package.json jest.config.js rollup.config.js script src tests tsconfig.base.json tsconfig.json",
		"lint": "pnpx @biomejs/biome lint --write ./src ./tests",
		"local-action": "pnpx @github/local-action . src/main.ts .env",
		"package": "rollup --config rollup.config.js",
		"package:watch": "pnpm run package -- --watch",
		"types": "ts-node ./scripts/types.ts",
		"test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 pnpx jest",
		"all": "pnpm run format && pnpm run lint && pnpm run test && pnpm run coverage && pnpm run package"
	},
	"license": "MIT",
	"dependencies": {
		"@actions/core": "3.0.1",
		"@actions/github": "9.1.1",
		"@octokit/webhooks-types": "7.6.1",
		"joi": "18.2.1",
		"lodash": "4.18.1",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.1",
		"@github/local-action": "7.0.1",
		"@jest/globals": "30.4.1",
		"@rollup/plugin-commonjs": "29.0.3",
		"@rollup/plugin-json": "6.1.0",
		"@rollup/plugin-node-resolve": "16.0.3",
		"@rollup/plugin-typescript": "12.3.0",
		"@types/jest": "30.0.0",
		"@types/js-yaml": "4.0.9",
		"@types/lodash": "4.17.24",
		"@types/node": "25.9.4",
		"jest": "30.4.2",
		"joi-to-typescript": "4.15.0",
		"rollup": "4.62.2",
		"ts-jest": "29.4.11",
		"ts-jest-resolver": "2.0.1",
		"ts-node": "10.9.2",
		"typescript": "6.0.3"
	},
	"optionalDependencies": {
		"@rollup/rollup-linux-x64-gnu": "4.62.0"
	},
	"packageManager": "pnpm@11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620"
}
