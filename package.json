{
	"name": "gh-labeler",
	"description": "GitHub Actions TypeScript template",
	"version": "0.0.0",
	"author": {
		"name": "twsl",
		"email": "45483159+twsl@users.noreply.github.com"
	},
	"type": "module",
	"private": true,
	"homepage": "https://github.com/twsl/gh-labeler",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/twsl/gh-labeler.git"
	},
	"bugs": {
		"url": "https://github.com/twsl/gh-labeler/issues"
	},
	"keywords": [
		"actions",
		"github",
		"typescript",
		"issues",
		"labels",
		"discussions",
		"close",
		"reopen",
		"lock",
		"unlock",
		"assign",
		"unassign",
		"comment",
		"delete"
	],
	"exports": {
		".": "./dist/index.js"
	},
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"bundle": "pnpm run format:write && pnpm run package",
		"format": "pnpx @biomejs/biome format --write ./src ./tests",
		"lint": "pnpx @biomejs/biome lint --write ./src ./tests",
		"local-action": "pnpx @github/local-action . src/main.ts .env",
		"package": "rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
		"package:watch": "pnpm run package -- --watch",
		"types": "ts-node ./scripts/types.ts",
		"test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 pnpx jest",
		"all": "pnpm run format:write && pnpm run lint && pnpm run test && pnpm run coverage && pnpm run package"
	},
	"license": "MIT",
	"dependencies": {
		"@actions/core": "^3.0.0",
		"@actions/github": "^9.0.0",
		"@octokit/webhooks-types": "^7.6.1",
		"joi": "^18.0.2",
		"lodash": "^4.17.23",
		"yaml": "^2.8.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.4",
		"@github/local-action": "^7.0.1",
		"@jest/globals": "^30.2.0",
		"@rollup/plugin-commonjs": "^29.0.0",
		"@rollup/plugin-json": "^6.1.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-typescript": "^12.3.0",
		"@types/jest": "^30.0.0",
		"@types/js-yaml": "^4.0.9",
		"@types/lodash": "^4.17.24",
		"@types/node": "^25.3.0",
		"jest": "^30.2.0",
		"joi-to-typescript": "^4.15.0",
		"rollup": "^4.59.0",
		"ts-jest": "^29.4.6",
		"ts-jest-resolver": "^2.0.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3"
	},
	"optionalDependencies": {
		"@rollup/rollup-linux-x64-gnu": "^4.59.0"
	},
	"packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"unrs-resolver"
		]
	}
}
