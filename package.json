{
	"name": "gh-labeler",
	"description": "GitHub Actions TypeScript template",
	"version": "0.0.0",
	"author": {
		"name": "twsl",
		"email": "45483159+twsl@users.noreply.github.com"
	},
	"type": "module",
	"private": true,
	"homepage": "https://github.com/twsl/gh-labeler",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/twsl/gh-labeler.git"
	},
	"bugs": {
		"url": "https://github.com/twsl/gh-labeler/issues"
	},
	"keywords": [
		"actions",
		"github",
		"typescript",
		"issues",
		"labels",
		"discussions",
		"close",
		"reopen",
		"lock",
		"unlock",
		"assign",
		"unassign",
		"comment",
		"delete"
	],
	"exports": {
		".": "./dist/index.js"
	},
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"bundle": "pnpm run format:write && pnpm run package",
		"format": "pnpx @biomejs/biome format --write ./src ./tests",
		"lint": "pnpx @biomejs/biome lint --write ./src ./tests",
		"local-action": "pnpx @github/local-action . src/main.ts .env",
		"package": "rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
		"package:watch": "pnpm run package -- --watch",
		"types": "ts-node ./scripts/types.ts",
		"test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 pnpx jest",
		"all": "pnpm run format:write && pnpm run lint && pnpm run test && pnpm run coverage && pnpm run package"
	},
	"license": "MIT",
	"dependencies": {
		"@actions/core": "^2.0.2",
		"@actions/github": "^7.0.0",
		"@octokit/webhooks-types": "^7.6.1",
		"joi": "^17.13.3",
		"lodash": "^4.17.21",
		"yaml": "^2.8.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.11",
		"@github/local-action": "^6.0.2",
		"@jest/globals": "^30.2.0",
		"@rollup/plugin-commonjs": "^29.0.0",
		"@rollup/plugin-json": "^6.1.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-typescript": "^12.3.0",
		"@types/jest": "^30.0.0",
		"@types/js-yaml": "^4.0.9",
		"@types/lodash": "^4.17.21",
		"@types/node": "^22.19.3",
		"jest": "^30.2.0",
		"joi-to-typescript": "^4.15.0",
		"rollup": "^4.55.1",
		"ts-jest": "^29.4.6",
		"ts-jest-resolver": "^2.0.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3"
	},
	"optionalDependencies": {
		"@rollup/rollup-linux-x64-gnu": "^4.55.1"
	},
	"packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"unrs-resolver"
		]
	}
}
