{
	"name": "gh-labeler",
	"description": "GitHub Actions TypeScript template",
	"version": "0.0.0",
	"author": {
		"name": "twsl",
		"email": "45483159+twsl@users.noreply.github.com"
	},
	"type": "module",
	"private": true,
	"homepage": "https://github.com/twsl/gh-labeler",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/twsl/gh-labeler.git"
	},
	"bugs": {
		"url": "https://github.com/twsl/gh-labeler/issues"
	},
	"keywords": [
		"actions",
		"github",
		"typescript",
		"issues",
		"labels",
		"discussions",
		"close",
		"reopen",
		"lock",
		"unlock",
		"assign",
		"unassign",
		"comment",
		"delete"
	],
	"exports": {
		".": "./dist/index.js"
	},
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"bundle": "bun run format && bun run package",
		"coverage": "bun test --parallel --timeout=15000 --coverage",
		"format": "bun x @biomejs/biome format --write .",
		"lint": "bun x @biomejs/biome lint --write .",
		"local-action": "bun x @github/local-action . src/main.ts .env",
		"package": "bun build src/index.ts --production --outdir dist --entry-naming=index.js --target=node --format=esm --sourcemap=external",
		"package:watch": "bun build src/index.ts --production --outdir dist --entry-naming=index.js --target=node --format=esm --sourcemap=external --watch",
		"types": "ts-node ./scripts/types.ts",
		"test": "bun test --parallel --timeout=15000",
		"all": "bun run format && bun run lint && bun run test && bun run coverage && bun run package"
	},
	"license": "MIT",
	"dependencies": {
		"@actions/core": "^3.0.1",
		"@actions/github": "^9.1.1",
		"@octokit/webhooks-types": "^7.6.1",
		"joi": "^18.2.8",
		"lodash": "^4.18.1",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@github/local-action": "^7.0.1",
		"@types/js-yaml": "^4.0.9",
		"@types/lodash": "^4.17.25",
		"@types/node": "^26.4.1",
		"joi-to-typescript": "^4.15.0",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.3"
	},
	"packageManager": "bun@1.4.0"
}
